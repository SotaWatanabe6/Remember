generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model MediaAsset {
  id                String    @id @default(uuid())
  memorialId        String    @map("memorial_id")
  contributorId     String?   @map("contributor_id")
  storagePath       String    @map("storage_path")
  storageBucket     String    @map("storage_bucket")
  fileName          String    @map("file_name")
  fileType          String    @map("file_type")
  fileSizeBytes     BigInt?   @map("file_size_bytes")
  width             Int?
  height            Int?
  takenAt           DateTime? @map("taken_at")
  locationLat       Float?    @map("location_lat")
  locationLng       Float?    @map("location_lng")
  uploadDevice      String?   @map("upload_device")
  caption           String?
  aiAnalysisStatus  String    @default("pending") @map("ai_analysis_status")
  aiLabels          Json?     @map("ai_labels")
  aiEmotion         String?   @map("ai_emotion")
  aiScene           String?   @map("ai_scene")
  aiPeopleCount     Int?      @map("ai_people_count")
  themeIds          Json?     @map("theme_ids")
  isFlagged         Boolean   @default(false) @map("is_flagged")
  flaggedReason     String?   @map("flagged_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @map("updated_at")

  @@map("media_assets")
}

model VoiceRecording {
  id                  String    @id @default(uuid())
  memorialId          String    @map("memorial_id")
  contributorId       String?   @map("contributor_id")
  storagePath         String    @map("storage_path")
  storageBucket       String    @map("storage_bucket")
  fileName            String    @map("file_name")
  fileType            String    @map("file_type")
  fileSizeBytes       BigInt?   @map("file_size_bytes")
  durationSeconds     Float?    @map("duration_seconds")
  contributorTitle    String    @map("contributor_title")
  transcriptionStatus String    @default("pending") @map("transcription_status")
  transcriptText      String?   @map("transcript_text")
  transcriptSegments  Json?     @map("transcript_segments")
  keyQuote            String?   @map("key_quote")
  aiCategory          String?   @map("ai_category")
  aiTags              Json?     @map("ai_tags")
  isFlagged           Boolean   @default(false) @map("is_flagged")
  flaggedReason       String?   @map("flagged_reason")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @map("updated_at")

  @@map("voice_recordings")
}
